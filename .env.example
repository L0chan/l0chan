# ================================================
# COMPARE2SAVE — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.
# ================================================

# --------------------------------------------------
# App Security
# --------------------------------------------------
C2S_SECRET_KEY=change-this-to-a-random-secret-in-production
C2S_ADMIN_USERNAME=admin
C2S_ADMIN_PASSWORD=admin@123

# --------------------------------------------------
# OpenAI — AI Shopping Assistant
# --------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --------------------------------------------------
# Twilio — SMS OTP Authentication
# --------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# --------------------------------------------------
# Database
# SQLite is used locally if DATABASE_URL is not set.
# For production (e.g. Render), paste your PostgreSQL
# External Connection String here.
# --------------------------------------------------
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --------------------------------------------------
# Cloudinary — Image Upload & Delivery
# --------------------------------------------------
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# --------------------------------------------------
# Firebase Admin (optional auth integration)
# --------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_PATH=path/to/serviceAccount.json
